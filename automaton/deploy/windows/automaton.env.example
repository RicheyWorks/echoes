# automaton config for the Windows services.
#
# install.ps1 reads this file and folds every KEY=VALUE into the
# NSSM AppEnvironmentExtra for each service. Edit, then re-run
# install.ps1 to push the changes.
#
# Format is the same as the Linux env file. Path values use
# Windows-style separators; backslashes are taken literally (no
# escape needed).

# Where the state store lives. Back this file up.
AUTOMATON_DB=%APPDATA%\automaton\automaton.db

# Logging - JSON format is friendlier for Event Viewer / log shippers.
AUTOMATON_LOG_FILE=%ProgramData%\automaton\logs\automaton.log
AUTOMATON_LOG_LEVEL=INFO
AUTOMATON_LOG_FORMAT=json

# Bearer token for POST routes on the UI / API. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# AUTOMATON_TOKEN=

# Migrations are off by default; run `automaton migrate` deliberately
# after upgrading the binary. Set to 1 to apply on service start.
# AUTOMATON_AUTO_MIGRATE=

# Optional: notifications (see deploy/litestream for off-host backup).
# AUTOMATON_NOTIFY_ON_FAILURE=ntfy://your-host/topic
# AUTOMATON_NOTIFY_QUIET_HOURS=22:00-07:00

# Headless secret-store. Windows Credential Manager (DPAPI) is the
# default and recommended path; only set this if you specifically want
# the encrypted-file fallback.
# AUTOMATON_KEYRING_BACKEND=os
