[Unit]
Description=automaton worker (drains the step queue)
After=network.target
PartOf=automaton.target

[Service]
Type=simple
User=automaton
Group=automaton
EnvironmentFile=/etc/automaton/automaton.env
ExecStart=/opt/automaton/venv/bin/automaton worker
Restart=always
RestartSec=5
# Don't kill the worker mid-step on stop - let it finish the current step.
# 60 seconds is more than enough for any reasonable step type.
KillSignal=SIGTERM
TimeoutStopSec=60

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/automaton /var/log/automaton
PrivateTmp=true

[Install]
WantedBy=multi-user.target
