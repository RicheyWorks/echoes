# Where the state store lives. Back this file up.
AUTOMATON_DB=/var/lib/automaton/automaton.db

# Logging.
AUTOMATON_LOG_FILE=/var/log/automaton/automaton.log
AUTOMATON_LOG_LEVEL=INFO
AUTOMATON_LOG_FORMAT=json

# Bearer token for /api/* write routes. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Anything POSTing to the API needs this in `Authorization: Bearer <value>`.
# Keep this file mode 600. Webhook endpoints have their own per-endpoint secrets.
AUTOMATON_TOKEN=REPLACE_ME_WITH_A_LONG_RANDOM_STRING
